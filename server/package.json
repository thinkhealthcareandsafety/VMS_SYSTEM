{
  "name": "vms-server",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "user:create": "node --env-file-if-exists=../.env scripts/create-user.js",
    "test": "node --test test/flow.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
