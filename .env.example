# Server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vms
JWT_SECRET=replace-with-32-plus-random-characters
SESSION_HOURS=12
COOKIE_SECURE=false
# Proxies in front of the server (1 = Nginx or Render alone, 2 = Vercel in front of Render)
TRUST_PROXY=1
APP_BASE_URL=http://localhost:5173
SITE_NAME=Visitor Desk
SITE_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
UPLOAD_DIR=uploads
APPROVAL_TTL_MINUTES=10
MAX_INSIDE_HOURS=10
ID_IMAGE_RETENTION_HOURS=24
SEED_PASSWORD=change-me-at-least-10
# Printer: file | tcp | off
PRINTER_MODE=file
PRINTER_HOST=
PRINTER_PORT=9100
# SMS: console | http
SMS_DRIVER=console
SMS_HTTP_URL=
SMS_HTTP_AUTH=
SMS_SENDER_ID=VMSITE
