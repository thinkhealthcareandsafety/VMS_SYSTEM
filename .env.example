# Server
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vms
JWT_SECRET=replace-with-32-plus-random-characters
SESSION_HOURS=12
COOKIE_SECURE=false
# Proxies in front of the server (1 = Nginx or Render alone, 2 = Vercel in front of Render)
TRUST_PROXY=1
APP_BASE_URL=http://localhost:5173
SITE_NAME=Visitor Desk
SITE_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
UPLOAD_DIR=uploads
APPROVAL_TTL_MINUTES=10
MAX_INSIDE_HOURS=10
ID_IMAGE_RETENTION_HOURS=24
SEED_PASSWORD=change-me-at-least-10
# Printer: file | tcp | off
PRINTER_MODE=file
PRINTER_HOST=
PRINTER_PORT=9100
# Mobile number verification (OTP) by MSG91. Leave empty for test mode: codes are only written to the server log.
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
OTP_EXPIRY_MINUTES=5
OTP_DAILY_LIMIT=300
OTP_VERIFIED_DAYS=90
# Host approval requests: sms (always SMS) | auto (Telegram if the host connected it, else SMS)
APPROVAL_CHANNEL=auto
MSG91_APPROVAL_TEMPLATE_ID=
MSG91_APPROVAL_VARS=var1,var2,var3
# SMS: console | http | msg91
SMS_DRIVER=console
SMS_HTTP_URL=
SMS_HTTP_AUTH=
SMS_SENDER_ID=VMSITE
