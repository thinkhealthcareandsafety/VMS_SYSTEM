# The hotel's settings. install.sh copies this to deploy/.env and fills the two secrets; you fill the rest.
# Never share this file: it holds the keys that protect the hotel's data.

# --- Addresses ---------------------------------------------------------------
# Inside the hotel: what the tablets and the admin PC open (a Cloudflare DNS record -> this PC's IP, grey cloud)
LAN_HOST=stregis-desk.gatesmartx.com
# On the internet: the address in hosts' WhatsApp / email links (the Cloudflare tunnel's public hostname)
APP_BASE_URL=https://stregis.gatesmartx.com
SITE_NAME=The St. Regis New Delhi & New Delhi Marriott Marquis
SITE_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91

# --- Cloudflare ----------------------------------------------------------------
# API token with Zone -> DNS -> Edit on gatesmartx.com (for the https certificate)
CF_API_TOKEN=
# Zero Trust -> Networks -> Tunnels -> your tunnel -> the token in the install command
TUNNEL_TOKEN=

# --- Secrets (install.sh fills these; never change ID_ENCRYPTION_KEY afterwards) ---
JWT_SECRET=
ID_ENCRYPTION_KEY=

# --- Where data lives on this PC ------------------------------------------------
DATA_DIR=/srv/vms/data
BACKUP_DIR=/mnt/vms-backup

# --- Messages (fill when ready; the system works without them) ---------------------
APPROVAL_CHANNEL=auto
APPROVAL_WHATSAPP=on
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
SMS_DRIVER=console
MSG91_AUTHKEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_APPROVAL_TEMPLATE_ID=
MSG91_ALERT_TEMPLATE_ID=
EMAIL_DRIVER=
EMAIL_FROM=
EMAIL_FROM_NAME=Security Desk
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Rules -----------------------------------------------------------------------
SESSION_HOURS=12
APPROVAL_TTL_MINUTES=10
MAX_INSIDE_HOURS=10
ID_IMAGE_RETENTION_HOURS=8760
